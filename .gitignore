# Build output - everything under build/ is reproducible from src/ via build.ps1.
build/

# Bootstrapped toolchain - tools/get-fasm.ps1 re-creates it deterministically
# (SHA-256-pinned download); the binaries never enter history.
tools/fasm/

# Future .NET test-harness output.
bin/
obj/

# Local tooling and working notes I keep - never in the public tree.
.claude/
CLAUDE.md
docs/internal/

# swarm.exe -capture writes its raw work-window samples and the report it
# reduces them to into the working directory; a run started from the repo root
# must not offer either of them for commit.
swarm-frames.bin
swarm-frames.txt

# Stryker's default output directory, for a run made by hand rather than
# through tools/mutation-test.ps1, which writes under build/ instead.
StrykerOutput/

# Editor litter.
.vs/
*.user
