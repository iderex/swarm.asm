<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- net9.0 per the masterplan. CI installs the 9.0.x runtime explicitly
         (ci.yml); the dev machine carries only newer runtimes, which the
         roll-forward covers. -->
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The committed lock file pins package hashes; CI restores in locked
         mode and keys its NuGet cache on it. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Microsoft Testing Platform, not VSTest. VSTest spawns a freshly built
         testhost.exe, which Device Guard / Smart App Control blocks on the dev
         machine; the MTP runner executes in-process under the trusted dotnet
         host, so `dotnet test` behaves identically here and in CI.

         Exe is the whole of it now. xunit.v3 4.x carries the platform runner
         and nothing else - the dependency renamed from xunit.v3.mtp-v1 to
         xunit.v3.mtp-v2 across the major - so the two properties that used to
         select it here, UseMicrosoftTestingPlatformRunner and
         TestingPlatformDotnetTestSupport, no longer select anything. The
         second one was worse than inert: it imported the VSTest bridge, which
         the platform refuses outright on the .NET 10 SDK, and that refusal is
         what turned the 4.0.0 bump into a migration (#343). What replaces
         both is `test.runner` in the repository's global.json, because the
         opt-in is now the SDK's rather than the project's. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The managed baseline (#153) is a benchmark subject, so it lives with
         the benchmark; the parity test that keeps it honest lives here. Linked
         rather than copied, because two copies of a force law are two force
         laws, and the one this suite asserts about has to be the one the
         published number was taken from. -->
    <Compile Include="../Swarm.Bench/ManagedBaseline.cs" Link="ManagedBaseline.cs" />
    <!-- The two ported competitor cores (#153), linked for the same reason:
         the port the suite asserts about has to be the one the published
         number was taken from. -->
    <Compile Include="../Swarm.Bench/CompetitorCores.cs" Link="CompetitorCores.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reference implementation the kernel is checked against. Its own
         project so the mutation run (#150) has a source assembly to mutate. -->
    <ProjectReference Include="../Swarm.Oracle/Swarm.Oracle.csproj" />
  </ItemGroup>

</Project>
